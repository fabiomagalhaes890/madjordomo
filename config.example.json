{
  // =====================================================================
  //  MAJORDOMO - config de exemplo
  //  Copie para config.json. Linhas que começam com // são ignoradas:
  //  para ligar um bloco, apague os // das linhas dele.
  //  Cada bloco opcional termina com vírgula; deixe "commands" sempre por último.
  // =====================================================================

  // ---------- Telegram (obrigatório). Deixe 0/null e rode uma vez para pegar os IDs.
  "telegram_token": "COLE_O_TOKEN_DO_BOTFATHER",
  "allowed_user_id": 0,
  "chat_id": 0,
  "topic_id": null,

  // ---------- Agente de IA (obrigatório)
  "project_dir": "C:/WORK/CLIENTE/workspace",
  // Claude Code:
  "claude_cmd": "claude",
  "claude_args": ["--permission-mode", "acceptEdits"],
  // Cursor CLI: comente as duas linhas acima e descomente as duas abaixo
  // "claude_cmd": "agent",
  // "claude_args": ["--force"],
  "timeout_min": 90,

  // Pasta FORA do repositório onde o agente grava os artefatos do pipeline
  // (docs/tasks, relatórios .md). Evita poluir o projeto. Um subdiretório por thread.
  "artifacts_dir": "C:/majordomo/artefatos",

  // ---------- Tarefas: use UM dos dois (Jira OU Azure DevOps)

  // Jira Cloud (para Server/Data Center troque email+api_token por "pat")
  // "jira": {
  //   "base_url": "https://SUAEMPRESA.atlassian.net",
  //   "email": "seu-email@empresa.com",
  //   "api_token": "TOKEN_DA_API_DO_JIRA",
  //   "jql": "assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC",
  //   "poll_min": 10
  // },

  // Azure DevOps: work items em seu nome + PRs do Azure Repos
  // PAT com escopos Work Items (Read) e Code (Read). "wiql" é opcional.
  // "azure_devops": {
  //   "org": "nome-da-organizacao",
  //   "project": "Nome do Projeto",
  //   "pat": "SEU_PERSONAL_ACCESS_TOKEN",
  //   "poll_min": 10,
  //   "pr_poll_min": 5,
  //   "watch_prs": true
  // },

  // ---------- PRs no GitHub (não use junto com os PRs do Azure DevOps)
  // Requer: winget install GitHub.cli  e  gh auth login
  // "github": {
  //   "owner": "nome-da-org-no-github",
  //   "poll_min": 5
  // },

  // ---------- Merge Requests no GitLab (não use junto com GitHub ou Azure Repos)
  // token = Personal Access Token com escopo "api" (ou read_api). base_url = o GitLab da empresa.
  // "gitlab": {
  //   "base_url": "https://gitlab.suaempresa.com",
  //   "token": "SEU_PERSONAL_ACCESS_TOKEN",
  //   "poll_min": 5
  // },

  // ---------- E-mail e agenda: use UM dos dois (Google OU Microsoft)

  // Google (Gmail + Agenda). Requer google_client.json e rodar: python google_auth.py
  // "google": {
  //   "gmail_poll_min": 3,
  //   "gmail_query": "is:unread in:inbox -category:promotions -category:social newer_than:2d",
  //   "gmail_ignore_from": ["noreply@github.com", "jira@"],
  //   "calendar": true,
  //   "remind_min": 10,
  //   "briefing_hour": 8
  // },

  // Microsoft 365 (Outlook + Agenda + chats do Teams). Requer rodar: python ms_auth.py
  // client_id = ID do aplicativo registrado no Entra ID (multilocatário, cliente público).
  // "microsoft": {
  //   "client_id": "COLE_O_CLIENT_ID",
  //   "tenant": "organizations",
  //   "mail_poll_min": 3,
  //   "mail_days": 2,
  //   "mail_ignore_from": ["azuredevops@microsoft.com"],
  //   "calendar": true,
  //   "remind_min": 10,
  //   "briefing_hour": 8,
  //   "teams": true,
  //   "teams_poll_min": 2
  // },

  // ---------- Reunião (meeting_watch.py): grava o áudio do sistema, transcreve local e resume
  // Requer: pip install faster-whisper soundcard numpy
  // "meeting": {
  //   "model": "medium",            // tiny|base|small|medium|large-v3 (pt: medium+ recomendado)
  //   "device": "auto",            // auto|cpu|cuda
  //   "language": "pt",
  //   "out_dir": "C:/majordomo/reunioes",
  //   "summarize": true             // false = só transcrição, sem gastar token
  // },

  // ---------- Slack (só se o workspace permitir instalar app; senão use e-mail de notificação)
  // "slack": {
  //   "user_token": "xoxp-...",
  //   "poll_min": 2,
  //   "approval_channel": "C0123456789",
  //   "approval_text": "Pessoal, PR pronto para revisão: {pr} {obs}"
  // },

  // ---------- Comportamento do agente (ajuste por cliente)
  "remote_preamble": "[Modo remoto] Você está rodando sem terminal; o Fabio acompanha e responde pelo Telegram, no celular. Sempre que um pipeline pedir checkpoint ou confirmação do usuário, PARE ali e termine a resposta com: resumo curto (no máximo ~15 linhas), a pergunta objetiva que precisa de resposta e o path do artefato em docs/tasks/<slug>/ com o detalhe completo. O usuário vai responder em uma próxima mensagem desta mesma sessão. Nunca inclua na resposta dados pessoais de alunos ou responsáveis (nome, CPF, e-mail, telefone, valores de um caso específico).",

  // Comandos de trabalho: {card} = id do card/work item, {obs} = texto extra.
  // Ajuste os templates para os nomes das suas skills/personas.
  "commands": {
    "/analisar": {
      "desc": "feature-pipeline até o checkpoint da Fase 1",
      "needs_card": true,
      "new_session": true,
      "template": "Rode a skill feature-pipeline para o card {card}. Observações do Fabio: {obs}."
    },
    "/investigar": {
      "desc": "bugfix-pipeline só até o diagnóstico (sem fix)",
      "needs_card": true,
      "new_session": true,
      "template": "Rode a skill bugfix-pipeline para o card {card}, executando apenas a investigação (bug-investigator) e parando no checkpoint do diagnóstico. Não corrija nada. Observações do Fabio: {obs}."
    },
    "/portar": {
      "desc": "legacy-parity-pipeline até o diagnóstico do legado",
      "needs_card": true,
      "new_session": true,
      "template": "Rode a skill legacy-parity-pipeline para o card {card}. Observações do Fabio: {obs}."
    },
    "/ok": {
      "desc": "aprova o checkpoint e segue o pipeline",
      "needs_card": false,
      "new_session": false,
      "template": "Aprovado. Siga para a próxima fase do pipeline do card {card}. Observações do Fabio: {obs}."
    },
    "/corrigir": {
      "desc": "após /investigar, segue para o fix",
      "needs_card": false,
      "new_session": false,
      "template": "Diagnóstico do card {card} aprovado. Siga o bugfix-pipeline a partir da correção (dev-senior, dev-reviewer). Observações do Fabio: {obs}."
    },
    "/pr": {
      "desc": "commit, push, PR e move o card (após você revisar o diff)",
      "needs_card": false,
      "new_session": false,
      "template": "O Fabio revisou o diff do card {card} e autorizou a entrega. Agora (e só por esta autorização explícita) crie uma branch com o nome do card se ainda não existir, faça commit com mensagem no padrão do projeto, push, abra o pull request sem merge e mova o card no Jira para a coluna de revisão/code review. Responda com o link do PR. Observações do Fabio: {obs}."
    }
  }
}
